<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen's bar (`CaptureWidget`): the mark, and what a press does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_capture"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_capture_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="20dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher_monochrome"
        android:tint="@color/widget_ink" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:text="@string/widget_capture"
        android:textColor="@color/widget_hint"
        android:textSize="16sp" />
</LinearLayout>
